<Window x:Class="QuickPanel.Windows.DockBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPanel Dock"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- v1.26：窗口最外层透明；浮动所需的上方余量放在胶囊**外面**，
         这样带底板模式下胶囊紧贴内容，不会出现上下大片空白。 -->
    <Border x:Name="RootBorder" Background="Transparent" BorderThickness="0"
            AllowDrop="True" ClipToBounds="False"
            DragOver="Dock_DragOver" DragLeave="Dock_DragLeave" Drop="Dock_Drop"
            MouseMove="Dock_MouseMove"
            MouseLeftButtonDown="Root_Down" MouseRightButtonUp="Root_RightClick">
        <Grid x:Name="HeadroomHost">
            <Grid.RowDefinitions>
                <!-- 浮动余量：仅用于让放大后的图标不被窗口裁切，本身不可见 -->
                <RowDefinition x:Name="HeadroomRow" Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 可见的胶囊（底板/描边都挂这里） -->
            <Border x:Name="PlateBorder" Grid.Row="1" Margin="0,0,0,2"
                    CornerRadius="16"
                    Background="{DynamicResource SurfaceOverlayBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    Padding="10,7">
                <StackPanel x:Name="DockContent" Orientation="Horizontal" ClipToBounds="False">
            <StackPanel.LayoutTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
            </StackPanel.LayoutTransform>

            <!-- F26 v0.5：⠿ 自由拖动手柄 -->
            <Border x:Name="DragGrip" CornerRadius="8" Padding="6,4" Margin="0,0,6,0"
                    VerticalAlignment="Center" Cursor="SizeAll" Background="Transparent"
                    ToolTip="按住拖动，把 Dock 放到任意位置"
                    MouseLeftButtonDown="Grip_Down">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardSubtleBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                            <TextBlock x:Name="GripText" Text="⠿" FontSize="15"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>

            <!-- F21：分组快进按钮（v0.5 悬停热切换） -->
            <ItemsControl x:Name="GroupButtons" ItemsSource="{Binding Groups}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="GroupBtn" CornerRadius="10" Margin="2,0" Padding="12,7"
                                Background="{DynamicResource CardSubtleBrush}"
                                Tag="{Binding}" Cursor="Hand"
                                MouseLeftButtonUp="GroupBtn_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="GroupText" Text="{Binding Name}" FontSize="13"
                                       MaxWidth="110" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Width="1" Margin="10,0" Background="{DynamicResource HairlineBrush}"/>

            <!-- F22/F23：钉选图标 + 弹钢琴放大（v0.5 支持拖出） -->
            <ItemsControl x:Name="PinHost" ItemsSource="{Binding DockPins}" VerticalAlignment="Center"
                          ClipToBounds="False"
                          AllowDrop="True"
                          DragOver="PinHost_DragOver"
                          Drop="PinHost_Drop">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="ClipToBounds" Value="False"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- F23 v0.8：悬停放大 1.32x + 上浮（Enter/Leave 动画，底板样式由代码控制） -->
                        <Border Width="44" Height="44" CornerRadius="12" Margin="3,0"
                                RenderTransformOrigin="0.5,0.5"
                                Tag="{Binding}" ToolTip="{Binding Name}" Cursor="Hand"
                                MouseLeftButtonDown="Pin_Down" MouseMove="Pin_MouseMove"
                                MouseEnter="Pin_Enter" MouseLeave="Pin_Leave"
                                MouseLeftButtonUp="Pin_Click" MouseRightButtonUp="Pin_RightClick"
                                MouseUp="Pin_MouseUp">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PinScale"/>
                                    <TranslateTransform x:Name="PinLift" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Width="1" Margin="10,0" Background="{DynamicResource HairlineBrush}"/>

            <!-- F25：设置入口 -->
            <Border CornerRadius="10" Padding="10,7" VerticalAlignment="Center"
                    Cursor="Hand" ToolTip="设置"
                    MouseLeftButtonUp="Settings_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardSubtleBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="GearText" Text="⚙" FontSize="15"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>

            <!-- v1.9：时钟 + 系统监控（可开关）；v1.10：独立字体缩放 -->
            <StackPanel x:Name="WidgetPanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="6,0,0,0" Visibility="Collapsed">
                <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="WidgetScaleTf" ScaleX="1" ScaleY="1"/>
                </StackPanel.LayoutTransform>
                <Border Width="1" Margin="4,0" Background="{DynamicResource HairlineBrush}"/>
                <StackPanel VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock x:Name="ClockText" Text="00:00" FontSize="14"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="DateText" Text="" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,1,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel x:Name="MonitorPanel" VerticalAlignment="Center" Margin="6,0,0,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="MonitorLine1" Text="CPU --" FontSize="9.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="MonitorLine2" Text="内存 --" FontSize="9.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
