<Window x:Class="QuickPanel.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPanel 设置"
        Width="640" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource SbBg}" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- v0.9：深/浅主题令牌（代码可切换） -->
        <SolidColorBrush x:Key="SbBg" Color="#FF17171C"/>
        <SolidColorBrush x:Key="SbNav" Color="#FF121217"/>
        <SolidColorBrush x:Key="SbCard" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="SbCardBorder" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SbText" Color="#FFE8EAF0"/>
        <SolidColorBrush x:Key="SbTextSub" Color="#FF9AA0AE"/>
        <SolidColorBrush x:Key="SbField" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SbFieldBorder" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="SbBtn" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="SbBtnBorder" Color="#47FFFFFF"/>
        <SolidColorBrush x:Key="SbBtnHover" Color="#42FFFFFF"/>
        <SolidColorBrush x:Key="SbBtnPress" Color="#21FFFFFF"/>
        <SolidColorBrush x:Key="SbSwatchBorder" Color="#59FFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SbTextSub}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SbCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SbCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SbBtn}"/>
            <Setter Property="Foreground" Value="{DynamicResource SbText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SbBtnBorder}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SbBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SbBtnPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource SbSwatchBorder}"
                                Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SbField}"/>
            <Setter Property="Foreground" Value="{DynamicResource SbText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SbFieldBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource SbText}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SbText}"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SbText}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 左侧导航 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SbTextSub}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SbCard}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SbText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧分类导航 ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource SbNav}" Padding="12,18,12,12">
            <StackPanel>
                <TextBlock Text="QuickPanel" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource SbText}" Margin="10,0,0,0"/>
                <TextBlock Text="设置中心" FontSize="11" Margin="10,2,0,16"/>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectedIndex="0" SelectionChanged="Nav_SelectionChanged"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBoxItem Content="常规"/>
                    <ListBoxItem Content="外观"/>
                    <ListBoxItem Content="Dock"/>
                    <ListBoxItem Content="面板"/>
                    <ListBoxItem Content="分组"/>
                    <ListBoxItem Content="数据"/>
                </ListBox>
                <TextBlock x:Name="VersionText" Text="v1.1.0" FontSize="10"
                           VerticalAlignment="Bottom" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ 右侧内容 ═══ -->
        <Grid Grid.Column="1" Margin="24,16,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SectionTitle" Text="常规" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource SbText}"/>
            <TextBlock x:Name="FirstRunHint" Grid.Row="1"
                       Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"/>

            <!-- 内容区：六个分类面板，代码切换可见性 -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <!-- ── 常规 ── -->
                <Grid x:Name="SecGeneral">
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer x:Name="ScrollGeneral" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="设置主题"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="ThemeDarkRadio" Content="深色" GroupName="stheme" Checked="Theme_Changed"/>
                                <RadioButton x:Name="ThemeLightRadio" Content="浅色" GroupName="stheme" Checked="Theme_Changed"/>
                            </StackPanel>
                            <TextBlock Text="全局热键（如 Alt+Q / Ctrl+Alt+Space）" Margin="0,16,0,0"/>
                            <TextBox x:Name="HotkeyBox" Height="34" VerticalContentAlignment="Center" Margin="0,6,0,0"/>
                            <CheckBox x:Name="AutostartCheck" Content="开机自启（写入 HKCU Run 键）" Margin="0,14,0,0"/>
                            <CheckBox x:Name="FullscreenHideCheck" Content="全屏时自动隐藏 Dock 与面板（游戏 / F11）" Margin="0,8,0,0"/>

                            <!-- v1.30：桌面留白 -->
                            <TextBlock Text="桌面" Margin="0,18,0,0" FontWeight="SemiBold"/>
                            <CheckBox x:Name="HideDesktopIconsCheck" Content="隐藏桌面图标（桌面留白，只留壁纸）"
                                      Margin="0,8,0,0" Click="HideDesktopIcons_Changed"/>
                            <TextBlock Text="快捷方式不会被删除，仍在桌面文件夹里；从面板、Dock 或资源管理器都能打开。隐藏期间桌面右键不可用，托盘菜单/这里可随时恢复；退出 QuickPanel 会自动恢复。"
                                       Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Text="鼠标热区唤出延迟" Margin="0,16,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="HotZoneSlider" Minimum="100" Maximum="1000"
                                        TickFrequency="50" IsMoveToPointEnabled="True"/>
                                <TextBlock x:Name="HotZoneText" Grid.Column="1" Text="200 ms"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SbText}"/>
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── 外观 ── -->
                <Grid x:Name="SecAppearance" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer x:Name="ScrollAppearance" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Dock 背景模式"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="ModeAcrylicRadio" Content="毛玻璃" GroupName="bgmode" Checked="Mode_Changed" Unchecked="Mode_Changed"/>
                                <RadioButton x:Name="ModeTransparentRadio" Content="全透明" GroupName="bgmode" Checked="Mode_Changed" Unchecked="Mode_Changed"/>
                                <RadioButton x:Name="ModeInvisibleRadio" Content="完全隐形（无底板）" GroupName="bgmode" Checked="Mode_Changed" Unchecked="Mode_Changed"/>
                            </StackPanel>
                            <TextBlock Text="Dock 底色 #AARRGGBB（仅「全透明」模式生效；选「完全隐形」可一键无底板）" Margin="0,16,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SurfaceColorBox" Height="30" VerticalContentAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SwatchButton}" Background="#C0151518" Tag="surface|#C0151518" Click="Swatch_Click" ToolTip="暗玻璃"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#80202020" Tag="surface|#80202020" Click="Swatch_Click" ToolTip="浅灰玻璃"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#3C151518" Tag="surface|#3C151518" Click="Swatch_Click" ToolTip="微透"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#10101018" Tag="surface|#10101018" Click="Swatch_Click" ToolTip="近乎全透"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="强调色 #RRGGBB" Margin="0,16,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AccentColorBox" Height="30" VerticalContentAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SwatchButton}" Background="#7C6FFF" Tag="accent|#7C6FFF" Click="Swatch_Click" ToolTip="紫"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#FF7C6F" Tag="accent|#FF7C6F" Click="Swatch_Click" ToolTip="橙红"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#4FC3F7" Tag="accent|#4FC3F7" Click="Swatch_Click" ToolTip="天蓝"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#66BB6A" Tag="accent|#66BB6A" Click="Swatch_Click" ToolTip="绿"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#FFD54F" Tag="accent|#FFD54F" Click="Swatch_Click" ToolTip="黄"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="面板的底色与不透明度在左侧「面板」页调整。"
                                       Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource SbText}"/>

                            <TextBlock Text="整体不透明度（Dock + 面板，含图标和文字）" Margin="0,16,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="OpacitySlider" Minimum="0.55" Maximum="1.0"
                                        Value="0.92" TickFrequency="0.01" IsMoveToPointEnabled="True"/>
                                <TextBlock x:Name="OpacityValueText" Grid.Column="1"
                                           Text="92%" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SbText}"/>
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── Dock ── -->
                <Grid x:Name="SecDock" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer x:Name="ScrollDock" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="位置"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="PosCenterRadio" Content="底部居中" GroupName="dockpos" Checked="Pos_Changed"/>
                                <RadioButton x:Name="PosFreeRadio" Content="自由拖动（按住 ⠿ 手柄）" GroupName="dockpos" Checked="Pos_Changed"/>
                                <Button Content="重置位置" Click="ResetPosition_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="DockTopmostCheck" Content="Dock 置顶显示（关闭时只在桌面显示，其他软件会覆盖它）"
                                      Margin="0,14,0,0" Click="DockTopmost_Changed"/>
                            <TextBlock Text="底板样式" Margin="0,16,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="PlateRadio" Content="带底板（胶囊亚克力）" GroupName="plate" Checked="Plate_Changed"/>
                                <RadioButton x:Name="BareRadio" Content="纯图标（无底无框，直接悬浮）" GroupName="plate" Checked="Plate_Changed"/>
                            </StackPanel>
                            <TextBlock Text="文字颜色 #RRGGBB（纯图标模式的分组名/手柄/齿轮）" Margin="0,16,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DockTextColorBox" Height="30" VerticalContentAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SwatchButton}" Background="#000000" Tag="docktext|#000000" Click="Swatch_Click" ToolTip="黑"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#FFFFFF" Tag="docktext|#FFFFFF" Click="Swatch_Click" ToolTip="白"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#7C6FFF" Tag="docktext|#7C6FFF" Click="Swatch_Click" ToolTip="紫"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#1A1A1A" Tag="docktext|#1A1A1A" Click="Swatch_Click" ToolTip="近黑"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#FFD54F" Tag="docktext|#FFD54F" Click="Swatch_Click" ToolTip="黄"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="DockDesktopOnlyCheck" Content="仅在桌面显示（打开其他软件时自动隐藏）"
                                      Margin="0,16,0,0" Click="DockDesktopOnly_Changed"/>

                            <!-- v1.22：Dock 常驻 -->
                            <CheckBox x:Name="DockAlwaysVisibleCheck"
                                      Content="Dock 常驻（永不自动隐藏）"
                                      Margin="0,10,0,0" Click="DockAlwaysVisible_Changed"/>
                            <TextBlock Text="开启后 Dock 一直显示：不受「仅桌面显示」「全屏隐藏」影响，始终停在屏幕上。"
                                       Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock Text="图标大小" Margin="0,16,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="IconScaleSlider" Minimum="0.6" Maximum="1.6"
                                Value="1.0" TickFrequency="0.05" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="IconScaleText" Grid.Column="1"
                                   Text="100%" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SbText}"/>
                    </Grid>

                    <!-- v1.12：样式细调 -->
                    <TextBlock Text="图钉大小" Margin="0,16,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="PinSizeSlider" Minimum="24" Maximum="64"
                                Value="44" TickFrequency="2" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="PinSizeText" Grid.Column="1" Text="44"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SbText}"/>
                    </Grid>

                    <TextBlock Text="图钉间距" Margin="0,12,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="PinSpacingSlider" Minimum="0" Maximum="16"
                                Value="6" TickFrequency="1" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="PinSpacingText" Grid.Column="1" Text="6"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SbText}"/>
                    </Grid>

                    <TextBlock Text="图钉圆角" Margin="0,12,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="PinRadiusSlider" Minimum="0" Maximum="22"
                                Value="12" TickFrequency="1" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="PinRadiusText" Grid.Column="1" Text="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SbText}"/>
                    </Grid>

                    <TextBlock Text="悬停放大倍数" Margin="0,12,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="HoverScaleSlider" Minimum="1.0" Maximum="1.8"
                                Value="1.32" TickFrequency="0.02" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="HoverScaleText" Grid.Column="1" Text="1.32x"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SbText}"/>
                    </Grid>

                    <TextBlock Text="悬停上浮距离" Margin="0,12,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="HoverLiftSlider" Minimum="0" Maximum="20"
                                Value="8" TickFrequency="1" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="HoverLiftText" Grid.Column="1" Text="8"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SbText}"/>
                    </Grid>

                    <!-- v1.9：组件 -->
                    <TextBlock Text="组件" Margin="0,18,0,0" FontWeight="SemiBold"/>
                    <CheckBox x:Name="ShowClockCheck" Content="显示时钟与日期" Margin="0,8,0,0"
                              Click="Widget_Changed"/>
                    <CheckBox x:Name="ClockSecondsCheck" Content="时钟显示秒" Margin="0,6,0,20"
                              Click="Widget_Changed"/>
                    <CheckBox x:Name="ShowMonitorCheck" Content="显示系统监控（CPU / 内存 / 网速）"
                              Click="Widget_Changed"/>
                    <TextBlock Text="组件字体大小（时钟 / 监控，独立于图标缩放）" Margin="0,14,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="WidgetScaleSlider" Minimum="0.7" Maximum="1.6"
                                Value="1.0" TickFrequency="0.05" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="WidgetScaleText" Grid.Column="1"
                                   Text="100%" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SbText}"/>
                    </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── 面板 ── -->
                <Grid x:Name="SecPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer x:Name="ScrollPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                                <!-- v1.29：面板独立底板（跟 Dock 分开，Dock 调透明不会把面板一起拖没） -->
                                <TextBlock Text="面板底色 #RRGGBB" Margin="0,16,0,0"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PanelSurfaceColorBox" Height="30" VerticalContentAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SwatchButton}" Background="#151518" Tag="panelsurface|#151518" Click="Swatch_Click" ToolTip="近黑"/>
                                        <Button Style="{StaticResource SwatchButton}" Background="#20242E" Tag="panelsurface|#20242E" Click="Swatch_Click" ToolTip="蓝灰"/>
                                        <Button Style="{StaticResource SwatchButton}" Background="#2A2A2A" Tag="panelsurface|#2A2A2A" Click="Swatch_Click" ToolTip="深灰"/>
                                        <Button Style="{StaticResource SwatchButton}" Background="#F2F3F7" Tag="panelsurface|#F2F3F7" Click="Swatch_Click" ToolTip="浅色"/>
                                        <Button Style="{StaticResource SwatchButton}" Background="#1B2A3A" Tag="panelsurface|#1B2A3A" Click="Swatch_Click" ToolTip="深蓝"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="面板不透明度" Margin="0,14,0,0"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PanelOpacitySlider" Minimum="0.05" Maximum="1.0"
                                            Value="0.94" TickFrequency="0.01" IsMoveToPointEnabled="True"/>
                                    <TextBlock x:Name="PanelOpacityText" Grid.Column="1"
                                               Text="94%" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SbText}"/>
                                </Grid>
                                <TextBlock Text="面板是主界面，建议 80% 以上；喜欢贴壁纸可以调低，文字会自动反色。"
                                           Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11"/>

                            <TextBlock Text="面板缩放（含搜索框，实时生效）" Margin="0,18,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="PanelScaleSlider" Minimum="0.8" Maximum="1.4"
                                        Value="1.0" TickFrequency="0.05" IsMoveToPointEnabled="True"/>
                                <TextBlock x:Name="PanelScaleText" Grid.Column="1"
                                           Text="100%" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SbText}"/>
                            </Grid>
                            <TextBlock Text="鼠标离开后自动收回（0 = 立即；点击其他窗口总是立即收回）" Margin="0,16,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="HideDelaySlider" Minimum="0" Maximum="2000"
                                        TickFrequency="100" IsMoveToPointEnabled="True"/>
                                <TextBlock x:Name="HideDelayText" Grid.Column="1" Text="300 ms"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SbText}"/>
                            </Grid>

                            <!-- v1.21：常驻模式 -->
                            <CheckBox x:Name="StayOpenCheck" Content="面板常驻（不自动收回，只在 Alt+Q / Esc 时关闭）"
                                      Margin="0,18,0,0" Click="StayOpen_Changed"/>
                            <TextBlock Text="开启后：鼠标移开不会收、点击其他窗口不会收，面板一直留在屏幕上。"
                                       Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── 分组 ── -->
                <Grid x:Name="SecGroups" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：分组列表 -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="分组" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ListBox x:Name="GroupEditList" Height="270"
                                     Background="{DynamicResource SbField}" BorderBrush="{DynamicResource SbFieldBorder}" BorderThickness="1"
                                     Foreground="{DynamicResource SbText}"
                                     DisplayMemberPath="Name"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonDown="GroupEdit_Down"
                                     PreviewMouseMove="GroupEdit_Move"
                                     AllowDrop="True"
                                     DragOver="GroupEdit_DragOver"
                                     Drop="GroupEdit_Drop">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource SbText}"/>
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SbBtnHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GroupRenameBox" Height="30" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="改名" Click="Group_Rename_Click" Margin="6,0,0,0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="新建" Click="Group_Add_Click" Padding="12,4"/>
                                <Button Content="删除" Click="Group_Delete_Click" Margin="6,0,0,0" Padding="12,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 右：该分组的条目列表 -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="GroupItemsHeader" Text="条目" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ListBox x:Name="GroupItemsList" Grid.Row="1" Height="270"
                                     Background="{DynamicResource SbField}" BorderBrush="{DynamicResource SbFieldBorder}" BorderThickness="1"
                                     Foreground="{DynamicResource SbText}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="GroupItems_DoubleClick"
                                     PreviewMouseLeftButtonDown="GroupItems_Down"
                                     PreviewMouseMove="GroupItems_Move"
                                     AllowDrop="True"
                                     DragOver="GroupItems_DragOver"
                                     Drop="GroupItems_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="18" Height="18"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- v1.15：目标不存在时红字提示 -->
                                            <TextBlock Grid.Column="2" Text="{Binding MissingHint}" FontSize="10"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Foreground="#FFCC4444"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SbBtnHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="移除条目" Click="GroupItems_Remove_Click" Padding="12,4"/>
                                <Button Content="移动到分组" Click="GroupItems_MoveTo_Click" Margin="6,0,0,0" Padding="12,4"/>
                                <Button Content="添加条目" Click="GroupItems_Add_Click" Margin="6,0,0,0" Padding="12,4"/>
                                <Button Content="扫描添加程序…" Click="GroupItems_Scan_Click" Margin="6,0,0,0" Padding="12,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── 数据 ── -->
                <Grid x:Name="SecData" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="备份配置" Click="Backup_Click"/>
                                <Button Content="恢复默认外观" Click="ResetAppearance_Click" Margin="8,0,0,0"/>
                                <Button Content="打开配置目录" Click="OpenConfigDir_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="配置为 %AppData%\QuickPanel\config.json（明文 JSON，可手改/备份/迁移）" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Button Content="完成" Click="Done_Click" Grid.Row="3" Style="{StaticResource PrimaryButton}"
                    Margin="0,12,0,0" Height="38" FontSize="14"/>
        </Grid>
    </Grid>
</Window>
