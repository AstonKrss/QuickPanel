<Window x:Class="QuickPanel.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPanel 初始设置"
        Width="680" Height="600"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <!-- 深色幽灵按钮 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#FFDCDDE2"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（紫色） -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF7C6FFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF7C6FFF"/>
            <Setter Property="Padding" Value="28,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard" CornerRadius="14" Background="#FF151518"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部：标题 + 步骤指示 -->
            <Grid Grid.Row="0" Margin="32,24,32,0">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="欢迎使用 QuickPanel"
                               FontSize="22" FontWeight="SemiBold" Foreground="#FFECEDF2"/>
                    <TextBlock x:Name="SubtitleText" Text="三步完成配置，马上开始使用"
                               FontSize="12.5" Foreground="#FF9AA0AE" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            x:Name="StepDots">
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#FF7C6FFF" Margin="4,0"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#33FFFFFF" Margin="4,0"/>
                    <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#33FFFFFF" Margin="4,0"/>
                    <Ellipse x:Name="Dot4" Width="8" Height="8" Fill="#33FFFFFF" Margin="4,0"/>
                </StackPanel>
            </Grid>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Margin="32,20,32,0">

                <!-- ═══ 第 1 步：欢迎 ═══ -->
                <StackPanel x:Name="PageWelcome" VerticalAlignment="Center">
                    <Border Background="#14FFFFFF" CornerRadius="12" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="QuickPanel 是一个常驻屏幕底部的快捷启动面板。"
                                       FontSize="14" Foreground="#FFDCDDE2" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="#FFB9BDC7"
                                       TextWrapping="Wrap" LineHeight="24">
                                <Run Text="· 按 "/><Run Text="Alt+Q" FontWeight="SemiBold" Foreground="#FF7C6FFF"/><Run Text=" 随时呼出分组面板"/>
                                <LineBreak/>
                                <Run Text="· 鼠标移到屏幕底部 Dock 上，图标会放大"/>
                                <LineBreak/>
                                <Run Text="· 拖文件到面板或 Dock 即可添加"/>
                                <LineBreak/>
                                <Run Text="· 全部数据存在本地，零联网、零上传"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="接下来会扫描你电脑上的快捷方式，自动分类整理，你可以自己勾选要导入哪些。"
                               Margin="0,20,0,0" FontSize="12" Foreground="#FF9AA0AE"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- ═══ 第 2 步：扫描与勾选 ═══ -->
                <Grid x:Name="PageScan" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="ScanSummaryText" Text="正在整理…"
                                   FontSize="12.5" Foreground="#FFB9BDC7" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SelectAllBtn" Content="全选" Click="SelectAll_Click"
                                    Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                            <Button x:Name="SelectNoneBtn" Content="全不选" Click="SelectNone_Click"
                                    Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                            <Button x:Name="RescanBtn" Content="刷新" Click="Rescan_Click"
                                    Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 扫描范围 -->
                    <CheckBox x:Name="IncludeStartMenuCheck" Grid.Row="1"
                              Content="同时整理开始菜单里的程序（数量较多）"
                              FontSize="12" Foreground="#FF9AA0AE"
                              Margin="0,0,0,8" Click="IncludeStartMenu_Changed"/>

                    <!-- 筛选框 -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="FilterBox" Height="32"
                                 VerticalContentAlignment="Center" FontSize="12.5"
                                 Background="#26FFFFFF" Foreground="#FFDCDDE2"
                                 BorderBrush="#44FFFFFF" CaretBrush="#FFDCDDE2"
                                 Padding="8,0"
                                 TextChanged="Filter_TextChanged"/>
                        <TextBlock x:Name="FilterHint" Text="按名称筛选…"
                                   Margin="11,0,0,0" VerticalAlignment="Center"
                                   FontSize="12.5" Foreground="#FF6A7080"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Border Grid.Row="3" Background="#0FFFFFFF" CornerRadius="10"
                            BorderBrush="#22FFFFFF" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                            <StackPanel x:Name="ScanListHost" Margin="16,14,16,14"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ═══ 第 3 步：热键 ═══ -->
                <StackPanel x:Name="PageHotkey" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Background="#14FFFFFF" CornerRadius="12" Padding="24,22">
                        <StackPanel>
                            <TextBlock Text="常用组合：Alt+Q、Ctrl+Alt+Space、Shift+F1"
                                       FontSize="12" Foreground="#FF9AA0AE" TextWrapping="Wrap"/>
                            <TextBox x:Name="HotkeyBox" Height="40" Margin="0,14,0,0"
                                     FontSize="16" VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Background="#26FFFFFF" Foreground="#FFECEDF2"
                                     BorderBrush="#55FFFFFF" CaretBrush="#FFECEDF2"
                                     Text="Alt+Q"/>
                            <TextBlock x:Name="HotkeyError" Text="" Margin="0,10,0,0"
                                       FontSize="12" Foreground="#FFFF6B6B"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                            <TextBlock Text="如果该组合已被其他程序占用，会自动换成 Ctrl+Alt+Q 并提示。"
                                       Margin="0,10,0,0" FontSize="11.5" Foreground="#FF8A90A0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ 第 4 步：外观 ═══ -->
                <StackPanel x:Name="PageAppearance" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Background="#14FFFFFF" CornerRadius="12" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="背景样式" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFDCDDE2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <RadioButton x:Name="AcrylicRadio" Content="毛玻璃"
                                             GroupName="bg" Foreground="#FFDCDDE2" FontSize="13"
                                             Margin="0,0,20,0" Checked="Appearance_Changed"/>
                                <RadioButton x:Name="TransparentRadio" Content="半透明"
                                             GroupName="bg" Foreground="#FFDCDDE2" FontSize="13"
                                             Margin="0,0,20,0" Checked="Appearance_Changed"/>
                                <RadioButton x:Name="InvisibleRadio" Content="完全透明"
                                             GroupName="bg" Foreground="#FFDCDDE2" FontSize="13"
                                             Checked="Appearance_Changed"/>
                            </StackPanel>
                            <TextBlock Text="完全透明 = 没有底板，图标直接浮在壁纸上"
                                       Margin="0,8,0,0" FontSize="11.5" Foreground="#FF8A90A0"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="强调色" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFDCDDE2" Margin="0,20,0,0"/>
                            <StackPanel x:Name="AccentPalette" Orientation="Horizontal" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="随时可以在设置里继续调整"
                               Margin="0,16,0,0" FontSize="11.5" Foreground="#FF8A90A0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ═══ 第 5 步：完成 ═══ -->
                <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Background="#1A7C6FFF" CornerRadius="12" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="配置完成！" FontSize="17" FontWeight="SemiBold"
                                       Foreground="#FFECEDF2"/>
                            <TextBlock x:Name="DoneSummaryText" Margin="0,10,0,0"
                                       FontSize="13" Foreground="#FFDCDDE2" TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="现在就可以用了" Margin="0,22,0,8"
                               FontSize="14" FontWeight="SemiBold" Foreground="#FFDCDDE2"/>
                    <TextBlock FontSize="12.5" Foreground="#FFB9BDC7" TextWrapping="Wrap" LineHeight="24">
                        <Run Text="· 按 "/><Run x:Name="DoneHotkeyRun" Text="Alt+Q" FontWeight="SemiBold" Foreground="#FF7C6FFF"/><Run Text=" 呼出面板"/>
                        <LineBreak/>
                        <Run Text="· 鼠标移到屏幕底部，Dock 上的图标会放大；点图标即可启动"/>
                        <LineBreak/>
                        <Run Text="· 在面板或 Dock 上右键，可以编辑、排序、新建分组"/>
                        <LineBreak/>
                        <Run Text="· 托盘图标右键 → 设置，可随时调整外观和行为"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- 底部按钮 -->
            <Grid Grid.Row="2" Margin="32,16,32,24">
                <Button x:Name="BackBtn" Content="上一步" Click="Back_Click"
                        Style="{StaticResource GhostButton}" Padding="20,8"
                        HorizontalAlignment="Left" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipBtn" Content="跳过" Click="Skip_Click"
                            Style="{StaticResource GhostButton}" Padding="20,8"
                            Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="NextBtn" Content="开始设置" Click="Next_Click"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
